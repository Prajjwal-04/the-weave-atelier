{
  "redirects": [
    {
      "source": "/atelier",
      "destination": "/the-atelier",
      "permanent": true
    },
    {
      "source": "/the-atelier/",
      "destination": "/the-atelier",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
